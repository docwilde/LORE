{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lore\" hook --engine claude --event session-start",
            "timeout": 30,
            "statusMessage": "Loading lore memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lore\" hook --engine claude --event prompt",
            "timeout": 15,
            "statusMessage": "Refreshing lore memory"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lore\" hook --engine claude --event pre-compact",
            "timeout": 30,
            "statusMessage": "Deriving lore beliefs before compaction"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lore\" hook --engine claude --event session-end",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${LORE_TOOL_EVIDENCE:-1}\" != 0 ] && [ -z \"${LORE_SKIP:-}\" ]; then exec \"${CLAUDE_PLUGIN_ROOT}/bin/lore\" tool-evidence hook --engine claude --event PostToolUse; else printf '%s\\n' '{}'; fi",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${LORE_TOOL_EVIDENCE:-1}\" != 0 ] && [ -z \"${LORE_SKIP:-}\" ]; then exec \"${CLAUDE_PLUGIN_ROOT}/bin/lore\" tool-evidence hook --engine claude --event PostToolUseFailure; else printf '%s\\n' '{}'; fi",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
