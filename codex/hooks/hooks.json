{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/lore\" hook --engine codex --event session-start",
            "timeout": 10,
            "statusMessage": "Loading LORE memory",
            "additionalContextLimit": 16000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/lore\" hook --engine codex --event prompt",
            "timeout": 10,
            "statusMessage": "Loading LORE graph context",
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
