#!/bin/sh
# Native plugin entrypoint. Startup hooks only use an already installed binary.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$root/rust/lore-core/Cargo.toml" | head -1)
matches() {
  [ -x "$1" ] || return 1
  reported=$("$1" --version 2>/dev/null) || return 1
  # Only the carrier's documented version output is accepted. Stable patch
  # releases preserve the CLI, hook, MCP and shared-store contracts.
  case "$reported" in
    "lore-rs "*) reported=${reported#lore-rs } ;;
  esac
  LC_ALL=C awk -v required="$version" -v actual="$reported" 'function valid(v, pre, ids, n, i) {
    if (v !~ ("^" stable suffix "$")) return 0
    pre = v
    sub(/\+.*/, "", pre)
    if (sub(/^[^-]*-/, "", pre)) {
      n = split(pre, ids, ".")
      for (i = 1; i <= n; i++)
        if (ids[i] ~ /^0[0-9]+$/) return 0
    }
    return 1
  }
  BEGIN {
    stable = "(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)"
    suffix = "(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?"
    if (!valid(required) || !valid(actual)) exit 1
    if (required !~ ("^" stable "$") || actual !~ ("^" stable "$")) exit (actual != required)
    split(required, r, "."); split(actual, a, ".")
    # Compare decimal strings without awk floating-point rounding.
    exit !(("x" a[1]) == ("x" r[1]) && ("x" a[2]) == ("x" r[2]) &&
      (length(a[3]) > length(r[3]) ||
       (length(a[3]) == length(r[3]) && ("x" a[3]) >= ("x" r[3]))))
  }'
}
if [ -n "${LORE_RS:-}" ]; then
  matches "$LORE_RS" || { printf 'LORE_RS must name a compatible native LORE carrier (required %s).\n' "$version" >&2; exit 1; }
  exec "$LORE_RS" "$@"
fi
candidate=$(command -v lore-rs || :)
if [ -n "$candidate" ] && matches "$candidate"; then exec "$candidate" "$@"; fi
cache=${LORE_NATIVE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/lore/native}
case "$cache" in /*) : ;; *) printf 'LORE native cache must be absolute.\n' >&2; exit 1 ;; esac
[ ! -L "$cache" ] || { printf 'LORE native cache must not be a symlink.\n' >&2; exit 1; }
# Source changes invalidate the carrier even in unpacked plugin installations.
fingerprint=$({ find "$root/rust/lore-core/src" -type f -exec sha256sum {} +; sha256sum "$root/Cargo.toml" "$root/rust/lore-core/Cargo.toml" "$root/Cargo.lock"; } | LC_ALL=C sort | sha256sum | cut -d' ' -f1)
target=$cache/$fingerprint
binary=$target/release/lore-rs
if matches "$binary"; then exec "$binary" "$@"; fi
if [ "${1:-}" = hook ]; then
  printf 'LORE native carrier is not installed; run the LORE setup command once.\n' >&2
  exit 1
fi
command -v cargo >/dev/null 2>&1 || { printf 'LORE requires Rust: install it from https://rustup.rs, then run LORE setup.\n' >&2; exit 1; }
mkdir -p "$target/tmp"
chmod 700 "$cache" "$target" "$target/tmp"
printf 'Building native LORE %s…\n' "$version" >&2
TMPDIR=$target/tmp CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2} CARGO_TARGET_DIR=$target cargo build --release --locked --manifest-path "$root/Cargo.toml" --package lore-core --bin lore-rs >&2
matches "$binary" || { printf 'Native LORE build/version check failed.\n' >&2; exit 1; }
exec "$binary" "$@"
