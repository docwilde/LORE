{
  "lore-memory": {
    "SessionStart": [
      {
        "type": "command",
        "command": "lore-rs hook --engine antigravity --event session-start",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "lore-rs hook --engine antigravity --event stop",
        "timeout": 15
      }
    ]
  },
  "lore-tool-evidence": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${LORE_TOOL_EVIDENCE:-1}\" != 0 ] && [ -z \"${LORE_SKIP:-}\" ]; then exec lore-rs tool-evidence hook --engine antigravity --event PostToolUse; else printf '%s\\n' '{}'; fi",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
